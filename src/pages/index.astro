---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Me from '../assets/ME.png';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const topics = [
	{
		num: '01',
		title: 'Building',
		text: 'Notes from the things I make, including the parts that break and what I learned fixing them.',
	},
	{
		num: '02',
		title: 'Ideas',
		text: 'Arguments about technology and society that I think are worth having, even if you disagree.',
	},
	{
		num: '03',
		title: 'Field notes',
		text: 'Life between Delhi and Dublin, and what it is like to study AI while it changes every month.',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Shourya Kapoor" description={SITE_DESCRIPTION} image={Me} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero">
				<div class="hero-text">
					<p class="eyebrow">Delhi → Dublin · MSc Computer Science, Trinity College Dublin</p>
					<h1>
						Hi, I'm Shourya.
						<span class="accent">I build things and write down what I learn.</span>
					</h1>
					<p class="lede">
						I'm studying intelligent systems in my final year at Trinity. This is where I think out
						loud: what I'm building, ideas I can't stop thinking about, and honest notes from the
						journey.
					</p>
					<div class="actions">
						<a class="btn primary" href="/blog">Read the blog</a>
						<a class="btn" href="/about">More about me</a>
					</div>
				</div>
				<div class="hero-photo">
					<div class="photo-frame">
						<Image src={Me} alt="Shourya Kapoor" width={480} loading="eager" />
					</div>
				</div>
			</section>

			<section class="topics" aria-labelledby="topics-heading">
				<h2 id="topics-heading" class="section-title">What I write about</h2>
				<div class="topic-grid">
					{
						topics.map((t) => (
							<article class="topic">
								<span class="num">{t.num}</span>
								<h3>{t.title}</h3>
								<p>{t.text}</p>
							</article>
						))
					}
				</div>
			</section>

			<section class="latest" aria-labelledby="latest-heading">
				<div class="latest-head">
					<h2 id="latest-heading" class="section-title">Latest writing</h2>
					<a class="all-link" href="/blog">All posts →</a>
				</div>
				<ul class="post-list">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>
									<span class="date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<span class="post-title">{post.data.title}</span>
									<span class="post-desc">{post.data.description}</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		width: 1100px;
		max-width: calc(100% - 2em);
	}
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.9fr);
		gap: 4rem;
		align-items: center;
		padding: 2.5rem 0 4.5rem;
	}
	.eyebrow {
		margin: 0 0 1rem;
		font-size: 0.75em;
		font-weight: 700;
		letter-spacing: 0.06em;
		color: var(--accent);
	}
	h1 {
		font-size: clamp(2.2rem, 4.6vw, 3.5rem);
		line-height: 1.12;
		margin-bottom: 1.25rem;
	}
	h1 .accent {
		display: block;
		color: var(--accent);
		font-style: italic;
		font-weight: 400;
	}
	.lede {
		max-width: 34em;
		color: rgb(var(--gray-dark));
		font-size: 1.05em;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.75rem;
	}
	.btn {
		display: inline-block;
		padding: 0.65em 1.4em;
		border: 1px solid var(--border);
		border-radius: 999px;
		color: rgb(var(--black));
		font-size: 0.9em;
		font-weight: 700;
		text-decoration: none;
		transition: transform 0.15s ease, border-color 0.2s ease, background-color 0.2s ease;
	}
	.btn:hover {
		border-color: var(--accent);
		color: var(--accent);
		transform: translateY(-1px);
	}
	.btn.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--bg);
	}
	.btn.primary:hover {
		background: var(--accent-dark);
		border-color: var(--accent-dark);
		color: var(--bg);
	}
	.hero-photo {
		position: relative;
		justify-self: center;
		max-width: 380px;
		width: 100%;
	}
	.hero-photo::before {
		content: '';
		position: absolute;
		inset: 0;
		transform: translate(18px, 18px);
		border: 2px solid var(--accent);
		border-radius: 24px;
		z-index: 0;
	}
	.photo-frame {
		position: relative;
		z-index: 1;
		overflow: hidden;
		border-radius: 24px;
		box-shadow: var(--box-shadow);
	}
	.photo-frame :global(img) {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: center 20%;
		border-radius: 0;
		transform: scale(1.05);
	}
	.section-title {
		font-size: 1.6em;
		margin-bottom: 1.25rem;
	}
	.topics {
		padding: 1rem 0 3.5rem;
	}
	.topic-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.25rem;
	}
	.topic {
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 18px;
		transition: border-color 0.2s ease, transform 0.2s ease;
	}
	.topic:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}
	.num {
		font-family: var(--font-serif);
		font-size: 0.9em;
		color: var(--accent);
	}
	.topic h3 {
		font-size: 1.3em;
		margin: 0.4rem 0 0.5rem;
	}
	.topic p {
		margin: 0;
		font-size: 0.85em;
		color: rgb(var(--gray));
	}
	.latest-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
	}
	.all-link {
		font-size: 0.85em;
		font-weight: 700;
		text-decoration: none;
	}
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--border);
	}
	.post-list li {
		border-bottom: 1px solid var(--border);
	}
	.post-list a {
		display: grid;
		grid-template-columns: 9rem minmax(0, 1fr);
		column-gap: 1.5rem;
		padding: 1.25rem 0.5rem;
		color: inherit;
		text-decoration: none;
		transition: background-color 0.2s ease;
	}
	.post-list a:hover {
		background: var(--accent-soft);
	}
	.date {
		grid-row: span 2;
		font-size: 0.8em;
		color: rgb(var(--gray));
		padding-top: 0.3em;
	}
	.post-title {
		font-family: var(--font-serif);
		font-size: 1.25em;
		font-weight: 600;
		color: rgb(var(--black));
	}
	.post-list a:hover .post-title {
		color: var(--accent);
	}
	.post-desc {
		font-size: 0.85em;
		color: rgb(var(--gray));
	}
	@media (max-width: 820px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 2.5rem;
			padding-top: 1.5rem;
		}
		.hero-photo {
			order: -1;
			max-width: 260px;
		}
		.topic-grid {
			grid-template-columns: 1fr;
		}
		.post-list a {
			grid-template-columns: 1fr;
		}
		.date {
			grid-row: auto;
		}
	}
</style>

---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2>
			<a href="/">{SITE_TITLE}</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="right">
			<div class="social-links">
				<a href="https://www.instagram.com/shouryyakapoor/" target="_blank" rel="noopener">
					<span class="sr-only">Shourya on Instagram</span>
					<svg viewBox="0 0 24 24" aria-hidden="true" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
						<rect x="2.5" y="2.5" width="19" height="19" rx="5"></rect>
						<circle cx="12" cy="12" r="4.2"></circle>
						<circle cx="17.6" cy="6.4" r="1" fill="currentColor" stroke="none"></circle>
					</svg>
				</a>
				<a href="https://github.com/ShouryaKapoor" target="_blank" rel="noopener">
					<span class="sr-only">Shourya on GitHub</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
				</a>
			</div>
			<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch between light and dark mode">
				<svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
				</svg>
				<svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
				</svg>
			</button>
		</div>
	</nav>
</header>

<script>
	const toggle = document.getElementById('theme-toggle');
	toggle?.addEventListener('click', () => {
		const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
		document.documentElement.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch (e) {}
	});
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		margin: 0;
		padding: 0 1.5em;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--border);
	}
	nav {
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	h2 {
		margin: 0;
		font-size: 1.05em;
	}
	h2 a {
		display: block;
		padding: 0.9em 0;
		color: rgb(var(--black));
		text-decoration: none;
	}
	h2 a:hover {
		color: var(--accent);
	}
	.internal-links {
		display: flex;
		gap: 0.25rem;
		font-size: 0.9em;
	}
	.right {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.social-links {
		display: flex;
		gap: 0.5rem;
	}
	.social-links a {
		display: flex;
		padding: 0.4em;
		color: rgb(var(--gray));
		transition: color 0.2s ease;
	}
	.social-links a:hover {
		color: var(--accent);
	}
	.theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 38px;
		height: 38px;
		border: 1px solid var(--border);
		border-radius: 50%;
		background: var(--surface);
		color: rgb(var(--black));
		cursor: pointer;
		transition: border-color 0.2s ease, color 0.2s ease;
	}
	.theme-toggle:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.icon-sun {
		display: none;
	}
	:global([data-theme='dark']) .icon-sun {
		display: block;
	}
	:global([data-theme='dark']) .icon-moon {
		display: none;
	}
	@media (max-width: 720px) {
		header {
			padding: 0 1em;
		}
		h2 {
			display: none;
		}
		.social-links {
			display: none;
		}
	}
</style>

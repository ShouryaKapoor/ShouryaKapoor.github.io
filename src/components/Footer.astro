---
const today = new Date();
---

<footer>
	<p class="sign-off">Thanks for reading. Ideas, disagreements and hellos are all welcome.</p>
	<div class="social-links">
		<a href="https://www.instagram.com/shouryyakapoor/" target="_blank" rel="noopener">Instagram</a>
		<span aria-hidden="true">·</span>
		<a href="https://github.com/ShouryaKapoor" target="_blank" rel="noopener">GitHub</a>
		<span aria-hidden="true">·</span>
		<a href="/rss.xml">RSS</a>
	</div>
	<p class="copy">&copy; {today.getFullYear()} Shourya Kapoor. Written between Delhi and Dublin.</p>
</footer>

<style>
	footer {
		margin-top: 3em;
		padding: 2.5em 1em 4em;
		border-top: 1px solid var(--border);
		color: rgb(var(--gray));
		text-align: center;
		font-size: 0.9em;
	}
	.sign-off {
		margin: 0 0 0.75em;
		font-family: var(--font-serif);
		font-style: italic;
		color: rgb(var(--gray-dark));
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 0.75em;
	}
	.social-links a {
		color: rgb(var(--gray));
		text-decoration: none;
	}
	.social-links a:hover {
		color: var(--accent);
	}
	.copy {
		margin: 1em 0 0;
		font-size: 0.85em;
	}
</style>
